# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/
gradle/wrapper/gradle-wrapper.jar

# Local configuration file
local.properties

# Android Studio
*.iml
.idea/
.DS_Store

# Signing files
*.jks
*.keystore

# Log files
*.log

# Navigation editor temp files
.navigation/

